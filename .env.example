# Copy to .env.local and fill in. Never commit .env.local (it's git-ignored).

# ── Web monitoring ────────────────────────────────────────────────
# A second key (from another free account) makes calls round-robin across both,
# falling back to the other whenever one is out of credits. Add _3, _4, _5 too.
FIRECRAWL_API_KEY=                    # https://firecrawl.dev
FIRECRAWL_API_KEY_2=                  # optional; doubles the monthly allowance

# ── LLM: writing + scoring (OpenAI-compatible, e.g. DeepSeek) ──────
LLM_API_KEY=                          # https://platform.deepseek.com
LLM_BASE_URL=https://api.deepseek.com
LLM_WRITER_MODEL=deepseek-chat        # drafts posts / carousels / blogs
LLM_UTILITY_MODEL=deepseek-chat       # scores each item (high volume)

# ── Embeddings for pgvector cohesion (Gemini, OpenAI-compatible) ───
# DeepSeek has no embeddings API, so embeddings stay on their own provider.
EMBEDDING_API_KEY=                    # https://aistudio.google.com/app/apikey
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1024             # must match vector(N) in the migrations

# ── Supabase (Postgres + pgvector) ────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # Settings → API → service_role (secret!)
SUPABASE_DB_URL=                      # Settings → Database → connection string; used by `npm run db:migrate`

# ── Auth: single-user password gate ───────────────────────────────
APP_PASSWORD=                         # your login passphrase
AUTH_SECRET=                          # random 32+ chars, e.g. `openssl rand -hex 32`
CRON_SECRET=                          # random string; also set as a GitHub Actions secret
EXTENSION_TOKEN=                      # optional; the Chrome extension's bearer token (extension/README.md)

# ── Email digest via Resend (optional; blank = notifications off) ──
RESEND_API_KEY=                       # https://resend.com
NOTIFY_EMAIL=                         # recipient. Free tier (no verified domain) can only send to your Resend account's own email.
NOTIFY_FROM=Signal Desk <onboarding@resend.dev>
NOTIFY_MIN_SCORE=65                   # only email items scoring at least this
NOTIFY_MAX_ITEMS=5

# ── Monitor tuning (optional) ─────────────────────────────────────
MONITOR_SEARCH_LIMIT=5                # per source, and news+web returns 2× this; search costs 2 credits per 10 results
MONITOR_TIME_RANGE=qdr:d              # Google tbs window: qdr:h | qdr:d | qdr:w | qdr:m
MONITOR_ARTICLE_MAX_AGE_DAYS=2
MONITOR_MAX_NEW_PER_RUN=24
MONITOR_BUDGET_MS=40000               # wall-clock budget per pass; keep under the ~60s serverless cap

# ── Deploy helpers (optional; used by the local Vercel CLI) ────────
VERCEL_TOKEN=
APP_URL=https://<your-app>.vercel.app # your production URL, no trailing slash
