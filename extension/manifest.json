{
  "manifest_version": 3,
  "name": "Signal Desk Agent",
  "version": "2.3.1",
  "description": "Works through job applications and other web tasks in your own browser while you watch. Started from Signal Desk's Agentic Apply or from the side panel.",
  "minimum_chrome_version": "121",
  "action": { "default_title": "Open the Signal Desk agent" },
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["sidePanel", "activeTab", "scripting", "storage", "debugger"],
  "host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [
    {
      "matches": ["https://linkedin-post-generator-eight-rosy.vercel.app/*", "http://localhost/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
